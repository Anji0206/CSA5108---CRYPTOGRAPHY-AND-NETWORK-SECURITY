#include <stdio.h>
#include <string.h>
int main() {
    char str[100], original[100];
    int k, i;
    printf("Enter text: ");
    scanf("%99s", str);
    strcpy(original, str);
    printf("Enter key: ");
    scanf("%d", &k);
    k = (k % 26 + 26) % 26;
    for(i = 0; str[i]; i++)
        str[i] = (str[i] - 'A' + k) % 26 + 'A';
    printf("Ciphertext: %s\n", str);
    for(i = 0; str[i]; i++)
        str[i] = (str[i] - 'A' - k + 26) % 26 + 'A';
    printf("Decrypted: %s\n", str);
    return 0;
}
